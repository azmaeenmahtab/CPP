#include<bits/stdc++.h>
using namespace std;
int main(){
     int t;
     cin >> t;
     while(t--){
 
       int n;
       string s;
       cin >> n;
       cin >> s;
 
       int count = 0;
 
       for(int i = n-1; i > 0; i--){
 
            if(s[i] != s[i-1]){
 
                s[i-1] = s[i];
                count++;
            }else{
 
                continue;
            }
       }
 
       // cout << s << endl;
       cout << count << endl;
        
    }
}
